---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft || import.meta.env.DEV);

const counts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-CN'));
---

<Base title="标签">
  <h1 class="page-title">标签</h1>
  <p class="page-desc">共 {tags.length} 个标签，{posts.length} 篇文章。</p>

  {
    tags.length === 0 ? (
      <p class="empty">还没有标签。在文章开头的 tags 里加几个就行。</p>
    ) : (
      <div class="tag-cloud">
        {tags.map(([tag, count]) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>
            {tag}
            <span class="count">{count}</span>
          </a>
        ))}
      </div>
    )
  }
</Base>
