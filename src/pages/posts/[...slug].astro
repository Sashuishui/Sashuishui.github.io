---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { formatDate, readingTime } from '../../utils';

export const getStaticPaths = (async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft || import.meta.env.DEV);
  posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const { title, date, tags, summary } = post.data;
---

<Base title={title} description={summary ?? title}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="dot">·</span>
        <span>{readingTime(post.body)} 分钟</span>
        {
          tags.length > 0 && (
            <>
              <span class="dot">·</span>
              <div class="tags">
                {tags.map((tag) => (
                  <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
                ))}
              </div>
            </>
          )
        }
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-footer">
      <div>{prev ? <a href={`/posts/${prev.id}/`}>← {prev.data.title}</a> : <span></span>}</div>
      <div>{next ? <a href={`/posts/${next.id}/`}>{next.data.title} →</a> : <span></span>}</div>
    </footer>
  </article>
</Base>
